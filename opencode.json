{
    "$schema": "https://opencode.ai/config.json",
    "permission": {
        "*": "ask",
        "read": {
            "*": "allow",
            "*.env": "deny",
            "*.env.*": "deny",
            ".env.example": "allow",
            ".env.test": "allow"
        },
        "grep": "allow",
        "list": "allow",
        "glob": "allow",
        "todowrite": "allow"
    },
    "mcp": {
        "better-auth": {
            "type": "remote",
            "url": "https://mcp.better-auth.com/mcp",
            "enabled": true
        },
        "playwright": {
            "type": "local",
            "command": ["pnpx", "@playwright/mcp@latest"],
            "enabled": true
        },
        "vercel": {
            "type": "remote",
            "url": "https://mcp.vercel.com",
            "enabled": true
        }
    }
}
