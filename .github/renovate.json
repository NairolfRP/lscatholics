{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)",
    ":separateMultipleMajorReleases",
    ":combinePatchMinorReleases",
    ":disableRateLimiting",
    "schedule:weekly"
  ],
  "rangeStrategy": "bump",
  "labels": ["dependencies", "renovate"],
  "packageRules": [
    {
      "description": "Group Adonis.Js dependencies",
      "matchPackageNames": ["@adonisjs/**"],
      "groupName": "adonisjs",
      "schedule": ["before 3am on sunday"]
    },
    {
      "description": "Group Vue and Inertia dependencies",
      "matchPackageNames": [
        "vue",
        "@vue/**",
        "@inertiajs/**",
        "lucide-vue-next"
      ],
      "groupName": "vue-inertia",
      "schedule": ["before 3am on sunday"]
    },
    {
      "description": "Group vite and plugins dependencies",
      "matchPackageNames": ["vite", "@vitejs/**", "@tailwindcss/vite"],
      "groupName": "vite",
      "schedule": ["before 3am on sunday"]
    },
    {
      "description": "Group TypeScript and tools",
      "matchPackageNames": [
        "typescript",
        "ts-node",
        "@types/**",
        "@adonisjs/tsconfig"
      ],
      "groupName": "typescript",
      "schedule": ["before 3am on sunday"]
    },
    {
      "description": "Limit SWC updates",
      "matchPackageNames": ["@swc/core"],
      "rangeStrategy": "pin",
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Group Tailwind and plugins",
      "matchPackageNames": ["tailwind", "tailwind-merge", "tw-animate-css"],
      "groupName": "tailwind"
    },
    {
      "description": "Group decorative/utility dependencies",
      "matchPackageNames": [
        "clsx",
        "luxon",
        "class-variance-authority",
        "reka-ui",
        "vue-sonner",
        "edge.js"
      ],
      "groupName": "utils"
    }
  ],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "minimumReleaseAge": "3 days",
  "dependencyDashboard": true,
  "timezone": "Europe/Paris",
  "schedule": ["before 3am on monday"],
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "automerge": false,
    "assignees": ["@nairolfrp"]
  }
}
