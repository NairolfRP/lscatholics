{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)",
    ":separateMultipleMajorReleases",
    ":combinePatchMinorReleases",
    ":disableRateLimiting",
    "schedule:weekly"
  ],
  "rangeStrategy": "bump",
  "labels": ["dependencies", "renovate"],
  "minimumReleaseAge": "3 days",
  "dependencyDashboard": true,
  "timezone": "Europe/Paris",
  "schedule": ["before 3am on monday"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "packageRules": [
    {
      "description": "Group Adonis.Js dependencies",
      "matchPackageNames": ["@adonisjs/**"],
      "groupName": "adonisjs",
      "schedule": ["before 3am on sunday"]
    },
    {
      "description": "Group Inertia and React dependencies",
      "matchPackageNames": [
        "react",
        "react-dom",
        "@inertiajs/**",
        "lucide-react"
      ],
      "groupName": "inertia-react",
      "schedule": ["before 3am on sunday"],
      "minimumReleaseAge": "5 days"
    },
    {
      "description": "Group TypeScript and tools",
      "matchPackageNames": [
        "typescript",
        "@types/**",
        "@adonisjs/tsconfig"
      ],
      "groupName": "typescript",
      "schedule": ["before 3am on sunday"],
      "minimumReleaseAge": "5 days"
    },
    {
      "description": "Group SQLite",
      "matchPackageNames": ["@libsql/sqlite3", "better-sqlite3"],
      "groupName": "libsql",
      "schedule": ["before 3am on sunday"],
      "minimumReleaseAge": "2 days"
    },
    {
      "description": "Group vite and plugins dependencies",
      "matchPackageNames": ["vite", "@vitejs/**", "@tailwindcss/vite"],
      "groupName": "vite",
      "schedule": ["before 3am on sunday"]
    },
    {
      "description": "Group Tailwind and plugins",
      "matchPackageNames": ["tailwind", "tailwind-merge", "tw-animate-css"],
      "groupName": "tailwind"
    },
    {
      "description": "Group decorative/utility dependencies",
      "matchPackageNames": [
        "shadcn",
        "clsx",
        "luxon",
        "class-variance-authority",
        "radix-ui",
        "sonner",
        "edge.js"
      ],
      "groupName": "utils"
    }
  ],
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "automerge": false,
    "assignees": ["@nairolfrp"]
  }
}
