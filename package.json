{
  "name": "lscatholics",
  "version": "2.0.0",
  "private": true,
  "description": "A web application for a Catholic Church roleplay project",
  "homepage": "https://github.com/NairolfRP/lscatholics#readme",
  "bugs": "https://github.com/NairolfRP/lscatholics/issues",
  "author": {
    "name": "NairolfRP",
    "url": "https://github.com/NairolfRP"
  },
  "funding": {
    "type": "patreon",
    "url": "https://patreon.com/NairolfRP"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NairolfRP/lscatholics.git"
  },
  "type": "module",
  "license": "LGPL-3.0-only",
  "scripts": {
    "start": "node bin/server.js",
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "test": "node ace test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck:server": "tsc --noEmit -p tsconfig.json",
    "typecheck:vue": "vue-tsc --noEmit -p inertia/tsconfig.json",
    "typecheck": "pnpm typecheck:server && pnpm typecheck:vue"
  },
  "imports": {
    "#auth/*": "./app/auth/*.js",
    "#core/*": "./app/core/*.js",
    "#contact/*": "./app/contact/*.js",
    "#discord/*": "./app/discord/*.js",
    "#events/*": "./app/events/*.js",
    "#news/*": "./app/news/*.js",
    "#pages/*": "./app/pages/*.js",
    "#mails/*": "./app/mails/*.js",
    "#providers/*": "./providers/*.js",
    "#database/*": "./database/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^7.8.2",
    "@adonisjs/eslint-config": "^2.1.2",
    "@adonisjs/prettier-config": "^1.4.5",
    "@adonisjs/tsconfig": "^1.4.1",
    "@japa/assert": "^4.1.1",
    "@japa/plugin-adonisjs": "^4.0.0",
    "@japa/runner": "^4.4.0",
    "@swc/core": "1.11.24",
    "@tailwindcss/vite": "^4.1.13",
    "@tuyau/utils": "^0.0.9",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.5.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "eslint": "^9.35.0",
    "hot-hook": "^0.4.0",
    "nock": "^14.0.10",
    "pino-pretty": "^13.1.1",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.13",
    "ts-node-maintained": "^10.9.6",
    "typescript": "~5.9.2",
    "vite": "^6.3.5",
    "vue-tsc": "^3.0.6"
  },
  "dependencies": {
    "@adonisjs-community/modules": "^1.1.0",
    "@adonisjs/ally": "^5.1.1",
    "@adonisjs/auth": "^9.4.2",
    "@adonisjs/core": "^6.19.0",
    "@adonisjs/cors": "^2.2.1",
    "@adonisjs/inertia": "^3.1.1",
    "@adonisjs/lucid": "^21.8.0",
    "@adonisjs/session": "^7.5.1",
    "@adonisjs/shield": "^8.2.0",
    "@adonisjs/static": "^1.1.1",
    "@adonisjs/vite": "^4.0.0",
    "@gtaw-oauth-providers/adonisjs-ally": "^2.0.1",
    "@inertiajs/vue3": "^2.1.3",
    "@tanstack/vue-query": "^5.87.4",
    "@tuyau/client": "^0.2.10",
    "@tuyau/core": "^0.4.2",
    "@tuyau/inertia": "^0.0.15",
    "@vinejs/vine": "^3.0.1",
    "@vue/server-renderer": "^3.5.20",
    "@vueuse/core": "^13.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.2.6",
    "edge.js": "^6.3.0",
    "lucide-vue-next": "^0.542.0",
    "luxon": "^3.7.2",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "reka-ui": "^2.5.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.3.7",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.20",
    "vue-sonner": "^2.0.8"
  },
  "hotHook": {
    "boundaries": [
      "./app/**/controllers/**/*.ts",
      "./app/**/middleware/*.ts"
    ]
  },
  "prettier": "@adonisjs/prettier-config",
  "packageManager": "pnpm@10.16.1+sha512.0e155aa2629db8672b49e8475da6226aa4bdea85fdcdfdc15350874946d4f3c91faaf64cbdc4a5d1ab8002f473d5c3fcedcd197989cf0390f9badd3c04678706"
}
