{
  "name": "lscatholics",
  "version": "2.0.0",
  "private": true,
  "description": "A web application for a Catholic Church roleplay project",
  "homepage": "https://github.com/NairolfRP/lscatholics#readme",
  "bugs": "https://github.com/NairolfRP/lscatholics/issues",
  "author": {
    "name": "NairolfRP",
    "url": "https://github.com/NairolfRP"
  },
  "funding": {
    "type": "patreon",
    "url": "https://patreon.com/NairolfRP"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NairolfRP/lscatholics.git"
  },
  "type": "module",
  "license": "LGPL-3.0-only",
  "scripts": {
    "deploy-build": "pnpm install && NODE_ENV=production node ace build && cd build && pnpm install --prod && NODE_ENV=production node ace migration:run --force && NODE_ENV=production node ace db:seed",
    "start": "node bin/server.js",
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "test": "node ace test",
    "db:dev": "turso dev --db-file tmp/local.db",
    "db:migrate": "node ace migration:run",
    "db:rollback": "node ace migration:rollback",
    "db:seed": "node ace db:seed",
    "db:wipe": "node ace db:wipe",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck:server": "tsc --noEmit -p tsconfig.json",
    "typecheck:vue": "vue-tsc --noEmit -p inertia/tsconfig.json",
    "typecheck": "pnpm typecheck:server && pnpm typecheck:vue"
  },
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#extensions/*": "./app/extensions/*.js",
    "#models/*": "./app/models/*.js",
    "#mails/*": "./app/mails/*.js",
    "#services/*": "./app/services/*.js",
    "#listeners/*": "./app/listeners/*.js",
    "#events/*": "./app/events/*.js",
    "#generated/*": "./.adonisjs/server/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#transformers/*": "./app/transformers/*.js",
    "#validators/*": "./app/validators/*.js",
    "#providers/*": "./providers/*.js",
    "#policies/*": "./app/policies/*.js",
    "#abilities/*": "./app/abilities/*.js",
    "#utils/*": "./app/utils/*.js",
    "#shared/*": "./app/shared/*.js",
    "#types/*": "./app/types/*.js",
    "#database/*": "./database/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js"
  },
  "exports": {
    "./registry": "./.adonisjs/client/registry.ts",
    "./data": "./.adonisjs/client/data.d.ts"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.0.0",
    "@adonisjs/eslint-config": "^3.0.0",
    "@adonisjs/prettier-config": "^1.4.5",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/api-client": "^3.2.1",
    "@japa/assert": "^4.2.0",
    "@japa/plugin-adonisjs": "^5.1.0",
    "@japa/runner": "^5.3.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@tailwindcss/vite": "^4.2.1",
    "@tuyau/utils": "^0.0.9",
    "@types/leaflet": "^1.9.21",
    "@types/luxon": "^3.7.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.1.0",
    "@types/sinon": "^21.0.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "better-sqlite3": "^12.6.2",
    "eslint": "^9.39.2",
    "hot-hook": "^0.4.0",
    "nock": "^14.0.10",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "sinon": "^21.0.1",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vue-tsc": "^3.2.4",
    "youch": "^4.1.0"
  },
  "dependencies": {
    "@adonisjs-community/modules": "^1.1.0",
    "@adonisjs/ally": "6.0.0",
    "@adonisjs/auth": "^10.0.0",
    "@adonisjs/bouncer": "^4.0.0",
    "@adonisjs/core": "^7.0.0",
    "@adonisjs/cors": "^3.0.0",
    "@adonisjs/inertia": "^4.0.0",
    "@adonisjs/lucid": "^22.0.0",
    "@adonisjs/session": "^8.0.0",
    "@adonisjs/shield": "^9.0.0",
    "@adonisjs/static": "^2.0.0",
    "@adonisjs/vite": "^5.1.0",
    "@gtaw-oauth-providers/adonisjs-ally": "^2.0.5",
    "@inertiajs/vue3": "^2.3.13",
    "@internationalized/date": "^3.10.1",
    "@libsql/sqlite3": "^0.3.1",
    "@tanstack/vue-query": "^5.92.9",
    "@tanstack/vue-table": "^8.21.3",
    "@tuyau/core": "^1.0.0",
    "@vee-validate/zod": "^4.15.1",
    "@vinejs/vine": "^4.3.0",
    "@vue/server-renderer": "^3.5.27",
    "@vueuse/core": "^14.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.3.1",
    "edge.js": "^6.5.0",
    "leaflet": "^1.9.4",
    "lucide-vue-next": "^0.563.0",
    "luxon": "^3.7.2",
    "marked": "^17.0.1",
    "reflect-metadata": "^0.2.2",
    "reka-ui": "^2.8.0",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.27",
    "vue-sonner": "^2.0.9",
    "zod": "^4.3.6"
  },
  "hotHook": {
    "boundaries": [
      "./app/**/controllers/**/*.ts",
      "./app/**/middleware/*.ts"
    ]
  },
  "prettier": "@adonisjs/prettier-config",
  "packageManager": "pnpm@10.30.2+sha512.36cdc707e7b7940a988c9c1ecf88d084f8514b5c3f085f53a2e244c2921d3b2545bc20dd4ebe1fc245feec463bb298aecea7a63ed1f7680b877dc6379d8d0cb4"
}
