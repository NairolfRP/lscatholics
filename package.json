    "@tuyau/client": "^0.2.10",
    "@tuyau/core": "^0.4.2",
    "@tuyau/inertia": "^0.0.15",
    "@vinejs/vine": "^3.0.1",
    "@vue/server-renderer": "^3.5.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "edge.js": "^6.2.1",
    "lucide-vue-next": "^0.540.0",
    "luxon": "^3.7.1",
    "pg": "^8.16.3",
