{
  "name": "lscatholics",
  "version": "2.0.0",
  "private": true,
  "description": "A web application for a Catholic Church roleplay project",
  "homepage": "https://github.com/NairolfRP/lscatholics#readme",
  "bugs": "https://github.com/NairolfRP/lscatholics/issues",
  "author": {
    "name": "NairolfRP",
    "url": "https://github.com/NairolfRP"
  },
  "funding": {
    "type": "patreon",
    "url": "https://patreon.com/NairolfRP"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NairolfRP/lscatholics.git"
  },
  "type": "module",
  "license": "LGPL-3.0-only",
  "scripts": {
    "start": "node bin/server.js",
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "test": "node ace test",
    "db:dev": "turso dev --db-file tmp/local.db",
    "db:migrate": "node ace migration:run",
    "db:rollback": "node ace migration:rollback",
    "db:seed": "node ace db:seed",
    "db:wipe": "node ace db:wipe",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck:server": "tsc --noEmit -p tsconfig.json",
    "typecheck:vue": "vue-tsc --noEmit -p inertia/tsconfig.json",
    "typecheck": "pnpm typecheck:server && pnpm typecheck:vue"
  },
  "imports": {
    "#auth/*": "./app/auth/*.js",
    "#core/*": "./app/core/*.js",
    "#contact/*": "./app/contact/*.js",
    "#dashboard/*": "./app/dashboard/*.js",
    "#discord/*": "./app/discord/*.js",
    "#events/*": "./app/events/*.js",
    "#news/*": "./app/news/*.js",
    "#pages/*": "./app/pages/*.js",
    "#mails/*": "./app/mails/*.js",
    "#shared/*": "./app/shared/*.js",
    "#providers/*": "./providers/*.js",
    "#database/*": "./database/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^7.8.2",
    "@adonisjs/eslint-config": "^2.1.2",
    "@adonisjs/prettier-config": "^1.4.5",
    "@adonisjs/tsconfig": "^1.4.1",
    "@japa/api-client": "^3.2.1",
    "@japa/assert": "^4.2.0",
    "@japa/plugin-adonisjs": "^4.0.0",
    "@japa/runner": "^5.3.0",
    "@swc/core": "1.15.8",
    "@tailwindcss/vite": "^4.1.13",
    "@tuyau/utils": "^0.0.9",
    "@types/leaflet": "^1.9.21",
    "@types/luxon": "^3.7.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.0.9",
    "@types/sanitize-html": "^2.16.0",
    "@types/sinon": "^21.0.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "eslint": "^9.39.2",
    "hot-hook": "^0.4.0",
    "nock": "^14.0.10",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.0",
    "sinon": "^21.0.1",
    "tailwindcss": "^4.1.18",
    "ts-node-maintained": "^10.9.6",
    "typescript": "~5.9.3",
    "vite": "^6.3.5",
    "vue-tsc": "^3.2.2"
  },
  "dependencies": {
    "@adonisjs-community/modules": "^1.1.0",
    "@adonisjs/ally": "^5.1.1",
    "@adonisjs/auth": "^9.5.1",
    "@adonisjs/bouncer": "^3.1.6",
    "@adonisjs/core": "^6.19.3",
    "@adonisjs/cors": "^2.2.1",
    "@adonisjs/inertia": "^3.1.1",
    "@adonisjs/lucid": "^21.8.2",
    "@adonisjs/session": "^7.7.1",
    "@adonisjs/shield": "^8.2.0",
    "@adonisjs/static": "^1.1.1",
    "@adonisjs/vite": "^4.0.0",
    "@gtaw-oauth-providers/adonisjs-ally": "^2.0.1",
    "@inertiajs/vue3": "^2.3.10",
    "@internationalized/date": "^3.10.1",
    "@libsql/sqlite3": "^0.3.1",
    "@tanstack/vue-query": "^5.92.7",
    "@tanstack/vue-table": "^8.21.3",
    "@tuyau/client": "^0.2.10",
    "@tuyau/core": "^0.4.2",
    "@tuyau/inertia": "^0.0.15",
    "@vee-validate/zod": "^4.15.1",
    "@vinejs/vine": "^4.2.0",
    "@vue/server-renderer": "^3.5.26",
    "@vueuse/core": "^14.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.3.1",
    "edge.js": "^6.4.0",
    "leaflet": "^1.9.4",
    "lucide-vue-next": "^0.562.0",
    "luxon": "^3.7.2",
    "marked": "^17.0.1",
    "reflect-metadata": "^0.2.2",
    "reka-ui": "^2.7.0",
    "sanitize-html": "^2.17.0",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.26",
    "vue-sonner": "^2.0.9",
    "zod": "^4.3.5"
  },
  "hotHook": {
    "boundaries": [
      "./app/**/controllers/**/*.ts",
      "./app/**/middleware/*.ts"
    ]
  },
  "prettier": "@adonisjs/prettier-config",
  "packageManager": "pnpm@10.28.0+sha512.05df71d1421f21399e053fde567cea34d446fa02c76571441bfc1c7956e98e363088982d940465fd34480d4d90a0668bc12362f8aa88000a64e83d0b0e47be48"
}
