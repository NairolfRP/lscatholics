{
  "name": "lscatholics",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "license": "LGPL-3.0-only",
  "engines": {
    "node": ">=24.14.0"
  },
  "description": "A web application for a Catholic Church roleplay project",
  "homepage": "https://github.com/NairolfRP/lscatholics#readme",
  "bugs": "https://github.com/NairolfRP/lscatholics/issues",
  "author": {
    "name": "NairolfRP",
    "url": "https://github.com/NairolfRP"
  },
  "funding": {
    "type": "patreon",
    "url": "https://patreon.com/NairolfRP"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NairolfRP/lscatholics.git"
  },
  "scripts": {
    "deploy-build": "pnpm install && NODE_ENV=production node ace build && cd build && pnpm install --prod && NODE_ENV=production node ace migration:run --force && NODE_ENV=production node ace db:seed",
    "start": "node bin/server.js",
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "test": "node ace test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit --project inertia/tsconfig.json",
    "db:dev": "turso dev --db-file tmp/local.db",
    "db:migrate": "node ace migration:run",
    "db:rollback": "node ace migration:rollback",
    "db:seed": "node ace db:seed",
    "db:wipe": "node ace db:wipe"
  },
  "imports": {
    "#app/*": "./app/*.js",
    "#core/*": "./app/core/*.js",
    "#auth/*": "./app/auth/*.js",
    "#billing/*": "./app/billing/*.js",
    "#careers/*": "./app/careers/*.js",
    "#characters/*": "./app/characters/*.js",
    "#dashboard/*": "./app/dashboard/*.js",
    "#donate/*": "./app/donate/*.js",
    "#discord/*": "./app/discord/*.js",
    "#pages/*": "./app/pages/*.js",
    "#posts/*": "./app/posts/*.js",
    "#roles/*": "./app/roles/*.js",
    "#scheduled_events/*": "./app/scheduled_events/*.js",
    "#shared/*": "./app/shared/*.js",
    "#types/*": "./app/types/*.js",
    "#users/*": "./app/users/*.js",
    "#mails/*": "./app/mails/*.js",
    "#generated/*": "./.adonisjs/server/*.js",
    "#providers/*": "./providers/*.js",
    "#database/*": "./database/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js"
  },
  "exports": {
    "./registry": "./.adonisjs/client/registry.ts",
    "./data": "./.adonisjs/client/data.d.ts"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.0.1",
    "@adonisjs/eslint-config": "^3.0.0",
    "@adonisjs/prettier-config": "^1.4.5",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/api-client": "^3.2.1",
    "@japa/assert": "^4.2.0",
    "@japa/plugin-adonisjs": "^5.1.0",
    "@japa/runner": "^5.3.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@rolldown/plugin-babel": "^0.2.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.1",
    "@types/babel__core": "^7.20.5",
    "@types/leaflet": "^1.9.21",
    "@types/luxon": "^3.7.1",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/sinon": "^21.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "better-sqlite3": "^12.8.0",
    "eslint": "^10.0.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "hot-hook": "^1.0.0",
    "nock": "^14.0.11",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "sinon": "^21.0.3",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "youch": "^4.1.0"
  },
  "dependencies": {
    "@adonisjs/ally": "6.0.0",
    "@adonisjs/auth": "^10.0.0",
    "@adonisjs/bouncer": "^4.0.0",
    "@adonisjs/core": "^7.0.1",
    "@adonisjs/cors": "^3.0.0",
    "@adonisjs/inertia": "^4.1.0",
    "@adonisjs/lucid": "^22.1.1",
    "@adonisjs/session": "^8.0.0",
    "@adonisjs/shield": "^9.0.0",
    "@adonisjs/static": "^2.0.1",
    "@adonisjs/vite": "^5.1.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@gtaw-oauth-providers/adonisjs-ally": "^2.0.6",
    "@inertiajs/react": "^2.3.18",
    "@internationalized/date": "^3.12.0",
    "@libsql/sqlite3": "^0.3.1",
    "@tanstack/react-form": "^1.28.5",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-table": "^8.21.3",
    "@tuyau/core": "^1.2.1",
    "@tuyau/react-query": "^1.1.0",
    "@vinejs/vine": "^4.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "edge.js": "^6.5.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.577.0",
    "luxon": "^3.7.2",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.4",
    "react-error-boundary": "^6.1.1",
    "react-leaflet": "5.0.0",
    "react-markdown": "^10.1.0",
    "reflect-metadata": "^0.2.2",
    "remark-breaks": "^4.0.0",
    "shadcn": "^4.0.8",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "use-debounce": "^10.1.0",
    "zod": "^4.3.6"
  },
  "hotHook": {
    "boundaries": [
      "./app/**/controllers/**/*.ts",
      "./app/**/middleware/*.ts"
    ]
  },
  "prettier": "@adonisjs/prettier-config",
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be",
  "pnpm": {
    "overrides": {
      "vite": "8.0.0"
    }
  }
}
