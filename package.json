    "pino-pretty": "^13.0.0",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.1.12",
    "ts-node-maintained": "^10.9.5",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
