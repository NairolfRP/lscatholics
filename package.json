{
    "name": "lscatholics",
    "version": "4.0.0",
    "private": true,
    "description": "A web application for a Catholic Church roleplay project",
    "homepage": "https://github.com/NairolfRP/lscatholics#readme",
    "bugs": "https://github.com/NairolfRP/lscatholics/issues",
    "license": "GPL-3.0-only",
    "author": {
        "name": "NairolfRP",
        "url": "https://github.com/NairolfRP"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/NairolfRP/lscatholics.git"
    },
    "funding": {
        "type": "patreon",
        "url": "https://patreon.com/NairolfRP"
    },
    "type": "module",
    "imports": {
        "#/*": "./src/*",
        "#server/*": "./src/server/*",
        "#shared/*": "./src/shared/*"
    },
    "scripts": {
        "dev": "dotenv run -f .env.local -- vite --port 3000",
        "generate-routes": "tsr generate",
        "build": "vite build",
        "vercel-build": "vite build && ([ \"$VERCEL_ENV\" != \"production\" ] || drizzle-kit migrate)",
        "preview": "vite preview",
        "test": "vitest --exclude '**/*.bench.*'",
        "pretest:e2e": "mkdir -p tmp && rm -f tmp/e2e.db* && dotenv run --override -f .env.e2e -- drizzle-kit migrate",
        "test:e2e": "playwright test",
        "posttest:e2e": "rm -f tmp/e2e.db*",
        "bench": "vitest bench --run --project 'bench*'",
        "lint": "oxlint --type-aware --disable-nested-config && eslint",
        "format": "oxfmt",
        "check": "oxfmt --check",
        "typecheck": "tsc --noEmit",
        "start": "node .output/server/index.mjs",
        "dev:seed": "tsx --env-file=.env.local scripts/dev-seed.ts",
        "simulate:webhook": "tsx --env-file=.env.local scripts/simulate-fleeca-webhook.ts",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:push": "drizzle-kit push",
        "db:pull": "drizzle-kit pull",
        "db:studio": "drizzle-kit studio"
    },
    "dependencies": {
        "@base-ui/react": "^1.9.0",
        "@better-auth/drizzle-adapter": "^1.7.20",
        "@better-auth/i18n": "^1.7.20",
        "@gtaw-oauth-providers/better-auth": "2.2.1",
        "@libsql/client": "^0.18.0",
        "@sentry/tanstackstart-react": "^11.12.0",
        "@t3-oss/env-core": "^0.13.11",
        "@tailwindcss/vite": "^4.3.5",
        "@tanstack/match-sorter-utils": "^9.2.6",
        "@tanstack/react-form": "^1.33.5",
        "@tanstack/react-query": "^5.107.1",
        "@tanstack/react-router": "^1.170.46",
        "@tanstack/react-router-devtools": "^1.167.3",
        "@tanstack/react-router-ssr-query": "^1.167.3",
        "@tanstack/react-start": "^1.169.5",
        "@tanstack/react-table": "^9.3.1",
        "@tanstack/router-plugin": "^1.169.0",
        "@unpic/react": "^1.0.2",
        "@vercel/analytics": "^2.0.1",
        "@vercel/functions": "^3.11.1",
        "@vercel/speed-insights": "^2.1.0",
        "better-auth": "^1.7.20",
        "class-variance-authority": "^0.7.1",
        "cmdk": "^1.1.1",
        "cn": "^0.4.0",
        "date-fns": "^4.4.0",
        "dotenv-cli": "^11.1.0",
        "drizzle-orm": "1.0.0-rc.5",
        "ky": "^2.2.0",
        "leaflet": "^1.9.4",
        "lucide-react": "^1.71.0",
        "next-themes": "^0.4.6",
        "nitro": "3.0.260903-beta",
        "pino": "10.4.0",
        "react": "19.3.0",
        "react-call": "^2.0.2",
        "react-day-picker": "^10.0.2",
        "react-dom": "19.3.0",
        "react-leaflet": "^5.0.0",
        "react-markdown": "^10.1.0",
        "react-number-format": "^5.4.5",
        "rehype-slug": "^6.0.0",
        "remark-breaks": "^4.0.0",
        "tailwindcss": "^4.3.5",
        "tw-animate-css": "^1.4.0",
        "unpic": "^4.2.2",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@codspeed/vitest-plugin": "^6.1.1",
        "@eslint/js": "^10.0.1",
        "@faker-js/faker": "^10.6.0",
        "@playwright/test": "^1.65.0",
        "@rolldown/plugin-babel": "^0.2.4",
        "@tailwindcss/typography": "^0.5.20",
        "@tanstack/devtools-vite": "^0.8.6",
        "@tanstack/react-devtools": "^0.10.14",
        "@tanstack/react-form-devtools": "^0.2.34",
        "@tanstack/react-query-devtools": "^5.107.1",
        "@tanstack/router-cli": "^1.168.0",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/react": "^16.3.3",
        "@types/leaflet": "^1.9.22",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@typescript-eslint/parser": "^8.72.2",
        "@typescript/native": "npm:typescript@^7.0.2",
        "@vitejs/plugin-react": "^6.3.0",
        "@vitest/browser-playwright": "^5.1.0",
        "babel-plugin-react-compiler": "^1.0.0",
        "discord-api-types": "^0.38.58",
        "dotenv": "^18.0.10",
        "drizzle-kit": "1.0.0-rc.5",
        "eslint": "^10.14.0",
        "eslint-plugin-drizzle": "1.0.0-rc.4",
        "eslint-plugin-oxlint": "^1.93.0",
        "jsdom": "^30.1.3",
        "oxfmt": "^0.72.0",
        "oxlint": "^1.93.0",
        "oxlint-tsgolint": "^7.0.2006",
        "pino-pretty": "^13.2.0",
        "playwright": "^1.65.0",
        "shadcn": "^4.23.0",
        "tsx": "^4.23.15",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.72.2",
        "vite": "^8.3.8",
        "vitest": "^5.1.0",
        "vitest-browser-react": "^2.3.0"
    },
    "engines": {
        "node": "24.22.3"
    },
    "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
