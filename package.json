{
    "name": "lscatholics-start",
    "version": "4.0.0",
    "private": true,
    "description": "A web application for a Catholic Church roleplay project",
    "homepage": "https://github.com/NairolfRP/lscatholics#readme",
    "bugs": "https://github.com/NairolfRP/lscatholics/issues",
    "license": "GPL-3.0-only",
    "author": {
        "name": "NairolfRP",
        "url": "https://github.com/NairolfRP"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/NairolfRP/lscatholics.git"
    },
    "funding": {
        "type": "patreon",
        "url": "https://patreon.com/NairolfRP"
    },
    "type": "module",
    "imports": {
        "#/*": "./src/*",
        "#server/*": "./src/server/*",
        "#shared/*": "./src/shared/*"
    },
    "scripts": {
        "dev": "dotenv -e .env.local -- sh -c \"vite --port 3000\"",
        "generate-routes": "tsr generate",
        "build": "vite build",
        "vercel-build": "vite build && ([ \"$VERCEL_ENV\" != \"production\" ] || drizzle-kit migrate)",
        "preview": "vite preview",
        "test": "vitest --exclude '**/*.bench.*'",
        "pretest:e2e": "rm -f tmp/e2e.db*",
        "test:e2e": "playwright test",
        "posttest:e2e": "rm -f tmp/e2e.db*",
        "bench": "vitest bench --run --project bench",
        "lint": "oxlint --type-aware --disable-nested-config && eslint",
        "format": "oxfmt",
        "check": "oxfmt --check",
        "typecheck": "tsc --noEmit",
        "start": "node .output/server/index.mjs",
        "dev:seed": "tsx --env-file=.env.local scripts/dev-seed.ts",
        "simulate:webhook": "tsx --env-file=.env.local scripts/simulate-fleeca-webhook.ts",
        "db:dev": "turso dev --db-file tmp/dev.db",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:push": "drizzle-kit push",
        "db:pull": "drizzle-kit pull",
        "db:studio": "drizzle-kit studio"
    },
    "dependencies": {
        "@base-ui/react": "^1.7.0",
        "@better-auth/drizzle-adapter": "^1.6.26",
        "@better-auth/i18n": "^1.6.26",
        "@faker-js/faker": "^10.5.0",
        "@gtaw-oauth-providers/better-auth": "^2.1.2",
        "@libsql/client": "^0.17.4",
        "@sentry/tanstackstart-react": "^10.69.0",
        "@t3-oss/env-core": "^0.13.11",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/match-sorter-utils": "^9.1.0",
        "@tanstack/react-form": "^1.33.3",
        "@tanstack/react-query": "^5.101.4",
        "@tanstack/react-router": "^1.170.23",
        "@tanstack/react-router-devtools": "^1.167.1",
        "@tanstack/react-router-ssr-query": "^1.167.1",
        "@tanstack/react-start": "^1.168.40",
        "@tanstack/react-table": "^9.1.0",
        "@tanstack/router-plugin": "^1.168.27",
        "@unpic/react": "^1.0.2",
        "@vercel/analytics": "^2.0.1",
        "@vercel/functions": "^3.9.1",
        "@vercel/speed-insights": "^2.0.0",
        "better-auth": "^1.6.26",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "date-fns": "^4.4.0",
        "dotenv-cli": "^11.0.0",
        "drizzle-orm": "^0.45.2",
        "ky": "^2.0.2",
        "leaflet": "^1.9.4",
        "lucide-react": "^1.30.0",
        "next-themes": "^0.4.6",
        "nitro": "npm:nitro-nightly@3.0.1-20260731-205209-52abde8a",
        "pino": "^10.3.1",
        "react": "19.2.8",
        "react-day-picker": "^10.0.1",
        "react-dom": "19.2.8",
        "react-leaflet": "^5.0.0",
        "react-markdown": "^10.1.0",
        "react-number-format": "^5.4.5",
        "rehype-slug": "^6.0.0",
        "remark-breaks": "^4.0.0",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@codspeed/vitest-plugin": "^5.7.1",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.62.1",
        "@rolldown/plugin-babel": "^0.2.3",
        "@tailwindcss/typography": "^0.5.20",
        "@tanstack/devtools-vite": "^0.8.3",
        "@tanstack/react-devtools": "^0.10.9",
        "@tanstack/react-form-devtools": "^0.2.32",
        "@tanstack/react-query-devtools": "^5.101.4",
        "@tanstack/router-cli": "^1.167.25",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/react": "^16.3.2",
        "@types/leaflet": "^1.9.22",
        "@types/node": "^26.2.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@typescript-eslint/parser": "^8.66.0",
        "@typescript/native": "npm:typescript@^7.0.2",
        "@vitejs/plugin-react": "^6.0.5",
        "@vitest/browser-playwright": "^4.1.10",
        "babel-plugin-react-compiler": "^1.0.0",
        "discord-api-types": "^0.38.53",
        "dotenv": "^17.4.2",
        "drizzle-kit": "0.31.9",
        "eslint": "^10.8.1",
        "eslint-plugin-drizzle": "^0.2.3",
        "eslint-plugin-oxlint": "^1.77.0",
        "jsdom": "^30.0.1",
        "oxfmt": "^0.62.0",
        "oxlint": "^1.77.0",
        "oxlint-tsgolint": "^7.0.2001",
        "pino-pretty": "^13.1.3",
        "playwright": "^1.62.1",
        "shadcn": "^4.16.2",
        "tsx": "^4.23.11",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.66.0",
        "vite": "^8.2.1",
        "vitest": "4.1.10",
        "vitest-browser-react": "^2.2.0"
    },
    "engines": {
        "node": ">=24.0.0"
    },
    "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee"
}
