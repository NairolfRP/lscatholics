{
    "name": "lscatholics",
    "version": "4.0.0",
    "private": true,
    "description": "A web application for a Catholic Church roleplay project",
    "homepage": "https://github.com/NairolfRP/lscatholics#readme",
    "bugs": "https://github.com/NairolfRP/lscatholics/issues",
    "license": "GPL-3.0-only",
    "author": {
        "name": "NairolfRP",
        "url": "https://github.com/NairolfRP"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/NairolfRP/lscatholics.git"
    },
    "funding": {
        "type": "patreon",
        "url": "https://patreon.com/NairolfRP"
    },
    "type": "module",
    "imports": {
        "#/*": "./src/*",
        "#server/*": "./src/server/*",
        "#shared/*": "./src/shared/*"
    },
    "scripts": {
        "dev": "dotenv run -f .env.local -- vite --port 3000",
        "generate-routes": "tsr generate",
        "build": "vite build",
        "vercel-build": "vite build && ([ \"$VERCEL_ENV\" != \"production\" ] || drizzle-kit migrate)",
        "preview": "vite preview",
        "test": "vitest --exclude '**/*.bench.*'",
        "pretest:e2e": "mkdir -p tmp && rm -f tmp/e2e.db*",
        "test:e2e": "playwright test",
        "posttest:e2e": "rm -f tmp/e2e.db*",
        "bench": "vitest bench --run --project bench",
        "lint": "oxlint --type-aware --disable-nested-config && eslint",
        "format": "oxfmt",
        "check": "oxfmt --check",
        "typecheck": "tsc --noEmit",
        "start": "node .output/server/index.mjs",
        "dev:seed": "tsx --env-file=.env.local scripts/dev-seed.ts",
        "simulate:webhook": "tsx --env-file=.env.local scripts/simulate-fleeca-webhook.ts",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:push": "drizzle-kit push",
        "db:pull": "drizzle-kit pull",
        "db:studio": "drizzle-kit studio"
    },
    "dependencies": {
        "@base-ui/react": "^1.8.0",
        "@better-auth/drizzle-adapter": "^1.7.7",
        "@better-auth/i18n": "^1.7.7",
        "@gtaw-oauth-providers/better-auth": "2.2.1",
        "@sentry/tanstackstart-react": "^11.4.0",
        "@t3-oss/env-core": "^0.13.11",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/match-sorter-utils": "^9.2.6",
        "@tanstack/react-form": "^1.33.5",
        "@tanstack/react-query": "^5.104.1",
        "@tanstack/react-router": "^1.170.41",
        "@tanstack/react-router-devtools": "^1.167.2",
        "@tanstack/react-router-ssr-query": "^1.167.3",
        "@tanstack/react-start": "^1.168.60",
        "@tanstack/react-table": "^9.2.6",
        "@tanstack/router-plugin": "^1.168.42",
        "@tursodatabase/serverless": "^1.4.0",
        "@unpic/react": "^1.0.2",
        "@vercel/analytics": "^2.0.1",
        "@vercel/functions": "^3.9.11",
        "@vercel/speed-insights": "^2.0.0",
        "better-auth": "^1.7.7",
        "class-variance-authority": "^0.7.1",
        "cmdk": "^1.1.1",
        "cn": "^0.4.0",
        "date-fns": "^4.4.0",
        "dotenv-cli": "^11.0.0",
        "drizzle-orm": "1.0.0-rc.4",
        "ky": "^2.1.0",
        "leaflet": "^1.9.4",
        "lucide-react": "^1.52.0",
        "next-themes": "^0.4.6",
        "nitro": "3.0.260903-beta",
        "pino": "^10.4.0",
        "react": "19.3.0",
        "react-day-picker": "^10.0.2",
        "react-dom": "19.3.0",
        "react-leaflet": "^5.0.0",
        "react-markdown": "^10.1.0",
        "react-number-format": "^5.4.5",
        "rehype-slug": "^6.0.0",
        "remark-breaks": "^4.0.0",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "unpic": "^4.2.2",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@codspeed/vitest-plugin": "^5.7.1",
        "@eslint/js": "^10.0.1",
        "@faker-js/faker": "^10.6.0",
        "@playwright/test": "^1.63.0",
        "@rolldown/plugin-babel": "^0.2.4",
        "@tailwindcss/typography": "^0.5.20",
        "@tanstack/devtools-vite": "^0.8.5",
        "@tanstack/react-devtools": "^0.10.13",
        "@tanstack/react-form-devtools": "^0.2.34",
        "@tanstack/react-query-devtools": "^5.104.1",
        "@tanstack/router-cli": "^1.167.40",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/react": "^16.3.3",
        "@tursodatabase/database": "^0.7.2",
        "@types/leaflet": "^1.9.22",
        "@types/node": "^26.6.4",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@typescript-eslint/parser": "^8.71.0",
        "@typescript/native": "npm:typescript@^7.0.2",
        "@vitejs/plugin-react": "^6.1.1",
        "@vitest/browser-playwright": "^5.0.3",
        "babel-plugin-react-compiler": "^1.0.0",
        "discord-api-types": "^0.38.56",
        "dotenv": "^18.0.5",
        "drizzle-kit": "1.0.0-rc.4",
        "eslint": "^10.12.0",
        "eslint-plugin-drizzle": "1.0.0-rc.4",
        "eslint-plugin-oxlint": "^1.86.0",
        "jsdom": "^30.1.2",
        "oxfmt": "^0.70.0",
        "oxlint": "^1.86.0",
        "oxlint-tsgolint": "^7.0.2003",
        "pino-pretty": "^13.2.0",
        "playwright": "^1.63.0",
        "shadcn": "^4.21.1",
        "tsx": "^4.23.15",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.71.0",
        "vite": "8.3.1",
        "vitest": "5.0.2",
        "vitest-browser-react": "^2.3.0"
    },
    "engines": {
        "node": "24.21.0"
    },
    "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d"
}
