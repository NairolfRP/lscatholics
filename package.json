{
    "name": "lscatholics-start",
    "private": true,
    "type": "module",
    "imports": {
        "#/*": "./src/*",
        "#server/*": "./src/server/*",
        "#shared/*": "./src/shared/*"
    },
    "scripts": {
        "dev": "dotenv -e .env.local -- sh -c \"NODE_OPTIONS='--import ./instrument.server.mjs' vite --port 3000\"",
        "generate-routes": "tsr generate",
        "build": "vite build && cp instrument.server.mjs .output/server",
        "preview": "vite preview",
        "test": "vitest --exclude '**/*.bench.*'",
        "bench": "vitest bench --run --project bench",
        "lint": "oxlint --type-aware --disable-nested-config && eslint",
        "format": "oxfmt",
        "check": "oxfmt --check",
        "typecheck": "tsc --noEmit",
        "start": "node --import ./.output/server/instrument.server.mjs .output/server/index.mjs",
        "dev:seed": "tsx --env-file=.env.local scripts/dev-seed.ts",
        "db:dev": "turso dev --db-file tmp/dev.db",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:push": "drizzle-kit push",
        "db:pull": "drizzle-kit pull",
        "db:studio": "drizzle-kit studio"
    },
    "dependencies": {
        "@base-ui/react": "^1.6.0",
        "@better-auth/drizzle-adapter": "^1.6.25",
        "@better-auth/i18n": "^1.6.25",
        "@faker-js/faker": "^10.5.0",
        "@gtaw-oauth-providers/better-auth": "^2.1.2",
        "@libsql/client": "^0.17.4",
        "@sentry/tanstackstart-react": "^10.67.0",
        "@t3-oss/env-core": "^0.13.11",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/match-sorter-utils": "latest",
        "@tanstack/react-devtools": "latest",
        "@tanstack/react-form": "latest",
        "@tanstack/react-query": "latest",
        "@tanstack/react-query-devtools": "latest",
        "@tanstack/react-router": "latest",
        "@tanstack/react-router-devtools": "latest",
        "@tanstack/react-router-ssr-query": "latest",
        "@tanstack/react-start": "latest",
        "@tanstack/react-table": "latest",
        "@tanstack/router-plugin": "^1.168.23",
        "@unpic/react": "^1.0.2",
        "@vercel/analytics": "^2.0.1",
        "@vercel/functions": "^3.7.5",
        "@vercel/speed-insights": "^2.0.0",
        "better-auth": "^1.6.25",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "date-fns": "^4.4.0",
        "dotenv-cli": "^11.0.0",
        "drizzle-orm": "^0.45.2",
        "ky": "^2.0.2",
        "lucide-react": "^0.577.0",
        "next-themes": "^0.4.6",
        "nitro": "npm:nitro-nightly@3.0.1-20260702-173353-03122331",
        "pino": "^10.3.1",
        "react": "19.2.8",
        "react-day-picker": "^10.0.1",
        "react-dom": "19.2.8",
        "react-markdown": "^10.1.0",
        "react-number-format": "^5.4.5",
        "rehype-slug": "^6.0.0",
        "remark-breaks": "^4.0.0",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.6.0",
