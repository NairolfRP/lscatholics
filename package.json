        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@typescript-eslint/parser": "^8.65.0",
        "@typescript/native": "npm:typescript@^7.0.2",
        "@vitejs/plugin-react": "^6.0.4",
        "@vitest/browser-playwright": "^4.1.10",
